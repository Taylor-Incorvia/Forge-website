{
  "name": "wildcard-arena-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website for Wildcard Arena, a StarCraft II melee mod.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite-ssg build",
    "preview": "vite preview --outDir dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@unhead/vue": "^2.0.0",
    "beasties": "^0.3.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-ssg": "^28.0.0",
    "vue-tsc": "^3.0.0"
  }
}
